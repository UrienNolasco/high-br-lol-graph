// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Match {
  matchId      String  @id
  gameCreation BigInt
  gameDuration Int
  gameMode     String
  queueId      Int
  gameVersion  String
  mapId        Int
  hasTimeline  Boolean @default(true)
  finalContext Json?
  populationEligible Boolean?
  populationExclusionReason String?

  teams        MatchTeam[]
  participants MatchParticipant[]
  timelineProjection MatchTimelineProjection?
  events       MatchEventProjection[]

  @@index([queueId])
  @@index([queueId, gameCreation(sort: Desc)])
  @@index([queueId, mapId, gameVersion])
  @@map("matches")
}

model MatchTimelineProjection {
  matchId String @id
  match Match @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  projectionVersion Int
  frameIntervalMs Int?
  observedEndMs Int?
  frames Json

  @@map("match_timeline_projections")
}

model MatchParticipant {
  matchId String
  puuid   String
  match   Match  @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  riotIdGameName String?
  riotIdTagline  String?
  finalStats     Json?
  summonerName   String
  championId     Int
  championName   String
  teamId         Int
  role           String
  lane           String
  win            Boolean

  // Estatísticas finais (Match V5)
  kills       Int
  deaths      Int
  assists     Int
  kda         Float
  goldEarned  Int
  totalDamage Int
  damageTaken Int
  visionScore Int
  totalCs     Int   @default(0)

  // Séries temporais (Timeline V5) - índice = minuto
  goldGraph   Int[]
  xpGraph     Int[]
  csGraph     Int[]
  damageGraph Int[]

  // Heatmaps e posicionamento
  deathPositions Json
  killPositions  Json
  wardPositions  Json
  pathingSample  Json

  // Comportamento detalhado
  skillOrder   String[]
  itemTimeline Json
  finalInventory Json?

  // Dados brutos (JSONB)
  runes      Json
  challenges Json
  pings      Json
  spells     Int[]

  @@id([matchId, puuid])
  @@index([puuid])
  @@index([championId])
  @@index([puuid, championId])
  @@index([puuid, role])
  @@map("match_participants")
}

model MatchTeam {
  id                 Int     @id @default(autoincrement())
  matchId            String
  teamId             Int
  win                Boolean
  bans               Int[]
  bansAvailable      Boolean?
  objectivesTimeline Json
  finalObjectives    Json?

  match Match @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@unique([matchId, teamId])
  @@map("match_teams")
}

model User {
  puuid         String @id
  gameName      String
  tagLine       String
  region        String @default("br1")
  profileIconId Int?
  summonerLevel Int?

  // Ranked stats (League-V4)
  summonerId   String?
  tier         String? // IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
  rank         String? // I, II, III, IV (null for Master+)
  leaguePoints Int?
  rankedWins   Int?
  rankedLosses Int?

  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([gameName, tagLine, region])
  @@index([gameName])
  @@index([tier])
  @@map("users")
}

model ChampionStats {
  id           Int    @id @default(autoincrement())
  championId   Int
  championName String
  patch        String
  queueId      Int

  // Estatísticas agregadas
  gamesPlayed Int @default(0)
  wins        Int @default(0)
  losses      Int @default(0)

  // Taxas
  banRate  Float @default(0)
  pickRate Float @default(0)

  // Tier calculado
  tier String @default("C")
  rank Int    @default(0)

  // Somas por partida; médias são calculadas na leitura.
  sumKda  Float @default(0)
  sumDpm  Float @default(0)
  sumCspm Float @default(0)
  sumGpm  Float @default(0)

  @@unique([championId, patch, queueId])
  @@index([patch, queueId])
  @@map("champion_stats")
}

model PlayerStats {
  id      Int    @id @default(autoincrement())
  puuid   String
  patch   String
  queueId Int    @default(420)

  gamesPlayed Int @default(0)
  wins        Int @default(0)
  losses      Int @default(0)

  roleDistribution Json @default("{}")

  lastUpdated DateTime @default(now())

  // Somas por partida; médias são calculadas na leitura.
  sumKda         Float @default(0)
  sumDpm         Float @default(0)
  sumCspm        Float @default(0)
  sumGpm         Float @default(0)
  sumVisionScore Float @default(0)

  @@unique([puuid, patch, queueId])
  @@index([puuid])
  @@index([puuid, patch])
  @@map("player_stats")
}

model PlayerChampionStats {
  id         Int    @id @default(autoincrement())
  puuid      String
  championId Int
  patch      String
  queueId    Int    @default(420)

  gamesPlayed Int @default(0)
  wins        Int @default(0)
  losses      Int @default(0)

  roleDistribution Json @default("{}")

  lastPlayedAt DateTime?

  // Somas por partida; médias são calculadas na leitura.
  sumKda         Float @default(0)
  sumDpm         Float @default(0)
  sumCspm        Float @default(0)
  sumGpm         Float @default(0)
  sumVisionScore Float @default(0)
  sumCsd15       Float @default(0)
  sumGd15        Float @default(0)
  sumXpd15       Float @default(0)
  laningSamples  Int   @default(0)

  @@unique([puuid, championId, patch, queueId])
  @@index([puuid])
  @@index([puuid, lastPlayedAt])
  @@index([championId])
  @@map("player_champion_stats")
}

// Durable inbox/outbox: RabbitMQ is a delivery mechanism, this is the source of truth.
enum ProcessingStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  COMPLETED
  FAILED
}

model MatchProcessing {
  matchId           String           @id
  status            ProcessingStatus @default(PENDING)
  attempts          Int              @default(0)
  priority          Int              @default(1)
  traceId           String?
  nextAttemptAt     DateTime         @default(now())
  publishedAt       DateTime?
  leaseToken        String?
  leaseUntil        DateTime?
  lastError         String?
  processingVersion Int?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  raw               MatchRaw?

  @@index([status, nextAttemptAt, publishedAt])
  @@index([status, leaseUntil])
  @@map("match_processing")
}

model MatchRaw {
  matchId   String          @id
  job       MatchProcessing @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  summary   Bytes?
  timeline  Bytes?
  updatedAt DateTime        @updatedAt

  @@map("match_raw")
}

// Pauses dispatch/claims while the offline rebuild is in progress, including after a crash.
model ProcessingMaintenance {
  id            Int       @id @default(1)
  rebuilding    Boolean   @default(false)
  targetVersion Int?
  startedAt     DateTime?
  completedAt   DateTime?

  @@map("processing_maintenance")
}

// Discovery is an observation of a queried account, never historical match rank.
// No FK to Match: lineage exists before ingestion and survives projection rebuilds.
model DiscoveryObservation {
  id               String   @id
  source           String
  observedAt       DateTime
  region           String?
  queriedPuuid     String
  queueFilter      Int?
  requestedCount   Int
  startIndex       Int
  rankTier         String?
  rankDivision     String?
  rankLeaguePoints Int?
  rankQueue        String?
  rankObservedAt   DateTime?
  lineageVersion   Int      @default(1)
  matches          MatchDiscovery[]

  @@index([source, observedAt])
  @@index([queriedPuuid, observedAt])
  @@map("discovery_observations")
}

model MatchDiscovery {
  observationId String
  matchId       String
  observation   DiscoveryObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@id([observationId, matchId])
  @@index([matchId])
  @@map("match_discoveries")
}

// Lossless event source identity. Null actor/team/position never means numeric zero.
model MatchEventProjection {
  matchId                 String
  frameIndex              Int
  eventIndex              Int
  match                   Match    @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  type                    String?
  timestampMs             Int?
  frameTimestampMs        Int?
  actorParticipantId      Int?
  actorPuuid              String?
  victimParticipantId     Int?
  victimPuuid             String?
  assistingParticipantIds Json?
  assistingPuuids         Json?
  sourceTeamId            Int?
  ownerTeamId             Int?
  beneficiaryTeamId       Int?
  positionX               Float?
  positionY               Float?
  lane                    String?
  tier                    String?
  payload                 Json
  quality                 Json
  metricVersion           Int
  processingVersion       Int
  processedAt             DateTime @default(now())

  @@id([matchId, frameIndex, eventIndex])
  @@index([matchId, type, timestampMs])
  @@index([actorPuuid, type])
  @@map("match_event_projections")
}
